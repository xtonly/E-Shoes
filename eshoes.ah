#!/bin/bash

# ================== 颜色代码 ==================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RESET='\033[0m'

# ================== 常量定义 ==================
SHOES_BIN="/usr/local/bin/shoes"
SHOES_CONF_DIR="/etc/shoes"
SHOES_CONF_FILE="${SHOES_CONF_DIR}/config.yaml"
SHOES_LINK_FILE="${SHOES_CONF_DIR}/config.txt"
SYSTEMD_FILE="/etc/systemd/system/shoes.service"
TMP_DIR="/tmp/shoesdl"

# ================== Root 检查 ==================
require_root() {
    [[ $EUID -ne 0 ]] && { echo -e "${RED}必须使用 root 权限！${RESET}"; exit 1; }
}

# ================== 辅助函数 ==================
check_installed() { command -v shoes >/dev/null 2>&1; }
check_running() { systemctl is-active --quiet shoes; }

# ================== 安装 (含 SS-2022) ==================
install_shoes_full() {
    echo -e "${GREEN}正在配置 Shoes 服务 (VLESS + AnyTLS + SS-2022)...${RESET}"
    
    mkdir -p "${SHOES_CONF_DIR}"

    # 1. 检查二进制文件
    if ! check_installed; then
        echo -e "${RED}未找到 shoes 文件，请先确保已下载！(或运行之前的下载脚本)${RESET}"
        # 这里默认你已经有了文件，如果丢失请告诉我补充下载逻辑
    fi
    chmod +x "${SHOES_BIN}"

    # 2. 生成基础参数
    HOST_NAME=$(hostname)
    [[ -z "$HOST_NAME" ]] && HOST_NAME="ShoeServer"
    SNI="icloud.com"
    
    # 3. 端口生成
    VLESS_PORT=$(shuf -i 20000-60000 -n 1)
    ANYTLS_PORT=$(shuf -i 20000-60000 -n 1)
    SS_PORT=$(shuf -i 20000-60000 -n 1)
    
    while [[ "$ANYTLS_PORT" == "$VLESS_PORT" ]]; do ANYTLS_PORT=$(shuf -i 20000-60000 -n 1); done
    while [[ "$SS_PORT" == "$VLESS_PORT" || "$SS_PORT" == "$ANYTLS_PORT" ]]; do SS_PORT=$(shuf -i 20000-60000 -n 1); done

    # 4. 密钥生成
    # Reality
    UUID=$(cat /proc/sys/kernel/random/uuid)
    KEYPAIR=$(${SHOES_BIN} generate-reality-keypair)
    PRIVATE_KEY=$(echo "$KEYPAIR" | grep "private key" | awk '{print $4}')
    PUBLIC_KEY=$(echo "$KEYPAIR" | grep "public key" | awk '{print $4}')
    SHID=$(openssl rand -hex 8)
    
    # SS-2022 (关键修正：使用 binary 生成正确长度的密钥)
    SS_METHOD="2022-blake3-aes-128-gcm"
    echo -e "${YELLOW}正在生成 SS-2022 专用密钥...${RESET}"
    SS_PASSWORD=$(${SHOES_BIN} generate-shadowsocks-2022-password "${SS_METHOD}")
    
    if [[ -z "$SS_PASSWORD" ]]; then
        echo -e "${RED}SS 密钥生成失败！可能 binary 版本不支持此命令。${RESET}"
        exit 1
    fi

    # 5. 生成证书 (AnyTLS用)
    openssl ecparam -genkey -name prime256v1 -out "${SHOES_CONF_DIR}/key.pem"
    openssl req -new -x509 -days 3650 -key "${SHOES_CONF_DIR}/key.pem" -out "${SHOES_CONF_DIR}/cert.pem" -subj "/CN=${SNI}" >/dev/null 2>&1

    # 6. 写入配置文件
    cat > "${SHOES_CONF_FILE}" <<EOF
- address: "0.0.0.0:${VLESS_PORT}"
  protocol:
    type: tls
    reality_targets:
      "${SNI}":
        private_key: "${PRIVATE_KEY}"
        short_ids: ["${SHID}"]
        dest: "${SNI}:443"
        vision: true
        protocol:
          type: vless
          user_id: "${UUID}"
          udp_enabled: true
- address: "0.0.0.0:${ANYTLS_PORT}"
  protocol:
    type: tls
    tls_targets:
      "${SNI}":
        cert: "/etc/shoes/cert.pem"
        key: "/etc/shoes/key.pem"
        protocol:
          type: anytls
          users:
            - name: anylts
              password: "${PUBLIC_KEY}"
          udp_enabled: true
- address: "0.0.0.0:${SS_PORT}"
  protocol:
    type: shadowsocks
    method: "${SS_METHOD}"
    password: "${SS_PASSWORD}"
    udp_enabled: true
EOF

    # 7. Systemd (必须使用 run -c)
    cat > "${SYSTEMD_FILE}" <<EOF
[Unit]
Description=Shoes Proxy Server
After=network.target

[Service]
Type=simple
User=root
ExecStart=${SHOES_BIN} run -c ${SHOES_CONF_FILE}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable shoes
    echo -e "${YELLOW}正在启动服务...${RESET}"
    systemctl restart shoes
    
    sleep 2

    if check_running; then
        HOST_IP=$(curl -s -4 http://www.cloudflare.com/cdn-cgi/trace | grep ip | awk -F= '{print $2}')
        
        # 构建 SS 链接 (格式: ss://base64(method:password)@ip:port#name)
        SS_BASE=$(echo -n "${SS_METHOD}:${SS_PASSWORD}" | base64 -w 0)
        
        cat > "${SHOES_LINK_FILE}" <<EOF
vless://${UUID}@${HOST_IP}:${VLESS_PORT}?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${SNI}&fp=random&pbk=${PUBLIC_KEY}&sid=${SHID}&type=tcp#${HOST_NAME}
anytls://${PUBLIC_KEY}@${HOST_IP}:${ANYTLS_PORT}?security=tls&sni=${SNI}&allowInsecure=1&type=tcp#${HOST_NAME}_Anytls
ss://${SS_BASE}@${HOST_IP}:${SS_PORT}#${HOST_NAME}_SS
EOF
        echo -e "${GREEN}安装成功！服务运行中。${RESET}"
        echo -e "${GREEN}SS-2022 端口: ${SS_PORT}${RESET}"
        echo ""
        cat "${SHOES_LINK_FILE}"
    else
        echo -e "${RED}启动失败！请查看日志。${RESET}"
        journalctl -u shoes -n 20 --no-pager
    fi
}

# ================== 菜单 ==================
show_menu() {
    clear
    echo -e "${GREEN}=== Shoes 管理 (SS-2022版) ===${RESET}"
    echo -e "运行状态: $(check_running && echo -e "${GREEN}运行中${RESET}" || echo -e "${RED}未运行${RESET}")"
    echo ""
    echo "1. 安装/重置服务 (集成 SS-2022)"
    echo "2. 卸载服务"
    echo "3. 启动"
    echo "4. 停止"
    echo "5. 重启"
    echo "6. 查看链接"
    echo "7. 查看日志"
    echo "0. 退出"
    echo -e "${GREEN}=====================${RESET}"
    read -p "请输入选项: " choice
}

require_root
while true; do
    show_menu
    case "$choice" in
        1) install_shoes_full ;;
        2) systemctl stop shoes; systemctl disable shoes; rm -f "$SYSTEMD_FILE"; systemctl daemon-reload; echo "已卸载" ;;
        3) systemctl start shoes ;;
        4) systemctl stop shoes ;;
        5) systemctl restart shoes ;;
        6) [[ -f "$SHOES_LINK_FILE" ]] && cat "$SHOES_LINK_FILE" || echo "无文件" ;;
        7) journalctl -u shoes -f ;;
        0) exit 0 ;;
        *) echo "无效选项" ;;
    esac
    read -p "按 Enter 继续..."
done
