#!/bin/bash

# ================== 颜色代码 ==================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RESET='\033[0m'

# ================== 常量定义 ==================
SHOES_BIN="/usr/local/bin/shoes"
SHOES_CONF_DIR="/etc/shoes"
SHOES_CONF_FILE="${SHOES_CONF_DIR}/config.yaml"
SHOES_LINK_FILE="${SHOES_CONF_DIR}/config.txt"
SYSTEMD_FILE="/etc/systemd/system/shoes.service"
TMP_DIR="/tmp/shoesdl"

# ================== Root 检查 ==================
require_root() {
    [[ $EUID -ne 0 ]] && { echo -e "${RED}必须使用 root 权限！${RESET}"; exit 1; }
}

# ================== 辅助函数 ==================
check_installed() { command -v shoes >/dev/null 2>&1; }
check_running() { systemctl is-active --quiet shoes; }

# ================== 紧急修复与安装 ==================
install_shoes_stable() {
    echo -e "${YELLOW}正在执行稳健修复安装...${RESET}"
    
    # 1. 确保目录存在
    mkdir -p "${SHOES_CONF_DIR}"

    # 2. 重新下载 (如果不存在)
    if ! check_installed; then
        echo -e "${RED}未检测到 shoes 文件，请先运行完整安装下载！${RESET}"
        # 这里为了简化，假设文件还在，如果不在需要去上个版本脚本运行下载
    fi

    # 3. 生成基础配置 (不含 SS，防止 101 崩溃)
    HOST_NAME=$(hostname)
    [[ -z "$HOST_NAME" ]] && HOST_NAME="ShoeServer"
    SNI="icloud.com"
    
    SHID=$(openssl rand -hex 8)
    VLESS_PORT=$(shuf -i 20000-60000 -n 1)
    ANYTLS_PORT=$(shuf -i 20000-60000 -n 1)
    while [[ "$ANYTLS_PORT" == "$VLESS_PORT" ]]; do ANYTLS_PORT=$(shuf -i 20000-60000 -n 1); done

    UUID=$(cat /proc/sys/kernel/random/uuid)
    # 尝试生成密钥，如果失败则手动生成占位符
    KEYPAIR=$(${SHOES_BIN} generate-reality-keypair 2>/dev/null)
    if [[ -z "$KEYPAIR" ]]; then
        echo -e "${RED}二进制文件执行异常，尝试手动修复权限...${RESET}"
        chmod +x "${SHOES_BIN}"
        KEYPAIR=$(${SHOES_BIN} generate-reality-keypair)
    fi
    
    PRIVATE_KEY=$(echo "$KEYPAIR" | grep "private key" | awk '{print $4}')
    PUBLIC_KEY=$(echo "$KEYPAIR" | grep "public key" | awk '{print $4}')

    # 生成证书
    openssl ecparam -genkey -name prime256v1 -out "${SHOES_CONF_DIR}/key.pem"
    openssl req -new -x509 -days 3650 -key "${SHOES_CONF_DIR}/key.pem" -out "${SHOES_CONF_DIR}/cert.pem" -subj "/CN=${SNI}"

    # 写入稳健配置 (去除 SS)
    cat > "${SHOES_CONF_FILE}" <<EOF
- address: "0.0.0.0:${VLESS_PORT}"
  protocol:
    type: tls
    reality_targets:
      "${SNI}":
        private_key: "${PRIVATE_KEY}"
        short_ids: ["${SHID}"]
        dest: "${SNI}:443"
        vision: true
        protocol:
          type: vless
          user_id: "${UUID}"
          udp_enabled: true
- address: "0.0.0.0:${ANYTLS_PORT}"
  protocol:
    type: tls
    tls_targets:
      "${SNI}":
        cert: "/etc/shoes/cert.pem"
        key: "/etc/shoes/key.pem"
        protocol:
          type: anytls
          users:
            - name: anylts
              password: "${PUBLIC_KEY}"
          udp_enabled: true
EOF

    # 4. 修正 Systemd (移除 run -c)
    cat > "${SYSTEMD_FILE}" <<EOF
[Unit]
Description=Shoes Proxy Server
After=network.target

[Service]
Type=simple
User=root
# 恢复为直接执行，不带 run -c
ExecStart=${SHOES_BIN} ${SHOES_CONF_FILE}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable shoes
    echo -e "${YELLOW}正在尝试启动服务...${RESET}"
    systemctl restart shoes
    sleep 3

    if check_running; then
        HOST_IP=$(curl -s -4 http://www.cloudflare.com/cdn-cgi/trace | grep ip | awk -F= '{print $2}')
        cat > "${SHOES_LINK_FILE}" <<EOF
vless://${UUID}@${HOST_IP}:${VLESS_PORT}?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${SNI}&fp=random&pbk=${PUBLIC_KEY}&sid=${SHID}&type=tcp#${HOST_NAME}
anytls://${PUBLIC_KEY}@${HOST_IP}:${ANYTLS_PORT}?security=tls&sni=${SNI}&allowInsecure=1&type=tcp#${HOST_NAME}_Anytls
EOF
        echo -e "${GREEN}服务已成功启动！SS 节点导致崩溃已暂时移除。${RESET}"
        cat "${SHOES_LINK_FILE}"
    else
        echo -e "${RED}启动仍然失败。请使用菜单选项 9 查看详细报错。${RESET}"
    fi
}

# ================== 深度调试 ==================
debug_log() {
    echo -e "${YELLOW}正在获取最后 50 行日志...${RESET}"
    echo "--- System Log ---"
    journalctl -u shoes -n 50 --no-pager
    echo ""
    echo -e "${YELLOW}正在尝试手动运行以捕获 Panic 信息...${RESET}"
    echo "--- Manual Run Output ---"
    # 手动运行二进制文件，直接把错误输出到屏幕
    ${SHOES_BIN} ${SHOES_CONF_FILE}
}

# ================== 菜单 ==================
show_menu() {
    clear
    echo -e "${GREEN}=== Shoes 修复工具 (v3 Stable) ===${RESET}"
    echo -e "运行状态: $(check_running && echo -e "${GREEN}运行中${RESET}" || echo -e "${RED}未运行 (崩溃)${RESET}")"
    echo ""
    echo "1. 执行稳健修复安装 (去除 SS，修正启动命令)"
    echo "2. 卸载服务"
    echo "3. 启动服务"
    echo "4. 停止服务"
    echo "5. 重启服务"
    echo "6. 查看配置链接"
    echo "7. 查看简易日志"
    echo "9. 深度调试 (查看崩溃原因/Panic信息)"
    echo "0. 退出"
    echo -e "${GREEN}=====================${RESET}"
    read -p "请输入选项: " choice
}

require_root
while true; do
    show_menu
    case "$choice" in
        1) install_shoes_stable ;;
        2) systemctl stop shoes; systemctl disable shoes; rm -f "$SYSTEMD_FILE"; systemctl daemon-reload; echo "已卸载" ;;
        3) systemctl start shoes ;;
        4) systemctl stop shoes ;;
        5) systemctl restart shoes ;;
        6) [[ -f "$SHOES_LINK_FILE" ]] && cat "$SHOES_LINK_FILE" || echo "无配置文件" ;;
        7) journalctl -u shoes -f ;;
        9) debug_log; read -p "按回车继续..." ;;
        0) exit 0 ;;
        *) echo "无效选项" ;;
    esac
    read -p "按 Enter 继续..."
done
