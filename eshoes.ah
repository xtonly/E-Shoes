#!/bin/bash

# ================== 颜色代码 ==================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RESET='\033[0m'

# ================== 常量定义 ==================
SHOES_BIN="/usr/local/bin/shoes"
SHOES_CONF_DIR="/etc/shoes"
SHOES_CONF_FILE="${SHOES_CONF_DIR}/config.yaml"
SHOES_LINK_FILE="${SHOES_CONF_DIR}/config.txt"
SYSTEMD_FILE="/etc/systemd/system/shoes.service"
TMP_DIR="/tmp/shoesdl"

# ================== Root 检查 ==================
require_root() {
    [[ $EUID -ne 0 ]] && { echo -e "${RED}必须使用 root 权限！${RESET}"; exit 1; }
}

# ================== 环境/架构检测 ==================
get_glibc_version() {
    GLIBC_VERSION=$(ldd --version | head -n1 | awk '{print $NF}')
    GLIBC_MAJOR=$(echo "$GLIBC_VERSION" | cut -d. -f1)
    GLIBC_MINOR=$(echo "$GLIBC_VERSION" | cut -d. -f2)
}

check_arch() {
    case "$(uname -m)" in
        x86_64)
            GNU_FILE="shoes-x86_64-unknown-linux-gnu.tar.gz"
            MUSL_FILE="shoes-x86_64-unknown-linux-musl.tar.gz"
            ;;
        aarch64|arm64)
            GNU_FILE="shoes-aarch64-unknown-linux-gnu.tar.gz"
            MUSL_FILE="shoes-aarch64-unknown-linux-musl.tar.gz"
            ;;
        *)
            echo -e "${RED}不支持的 CPU 架构！${RESET}"
            exit 1
            ;;
    esac
}

# ================== 下载与更新 ==================
get_latest_version() {
    LATEST_VER=$(curl -s https://api.github.com/repos/cfal/shoes/releases/latest \
        | grep '"tag_name":' \
        | sed -E 's/.*"v?([^"]+)".*/\1/')
    [[ -z "$LATEST_VER" ]] && {
        echo -e "${RED}无法获取 Shoes 最新版本，请检查网络！${RESET}"
        exit 1
    }
}

test_shoes_binary() {
    ${SHOES_BIN} generate-reality-keypair >/dev/null 2>&1
}

download_shoes() {
    if command -v shoes >/dev/null 2>&1; then
        if test_shoes_binary; then
            echo -e "${GREEN}检测到 Shoes 已安装且正常，跳过下载步骤。${RESET}"
            return
        fi
    fi

    echo -e "${GREEN}开始下载 Shoes 核心...${RESET}"
    get_glibc_version
    check_arch
    get_latest_version

    if (( GLIBC_MAJOR < 2 )) || (( GLIBC_MAJOR == 2 && GLIBC_MINOR < 38 )); then
        DOWNLOAD_FILE="${MUSL_FILE}"
        DOWNLOAD_TYPE="MUSL"
    else
        DOWNLOAD_FILE="${GNU_FILE}"
        DOWNLOAD_TYPE="GNU"
    fi

    mkdir -p "${TMP_DIR}"
    cd "${TMP_DIR}" || exit 1

    DOWNLOAD_URL="https://github.com/cfal/shoes/releases/download/v${LATEST_VER}/${DOWNLOAD_FILE}"
    echo -e "${GREEN}下载 (${DOWNLOAD_TYPE}): ${DOWNLOAD_URL}${RESET}"

    wget -O shoes.tar.gz "$DOWNLOAD_URL" || {
        if [[ "$DOWNLOAD_TYPE" == "GNU" ]]; then
            echo -e "${YELLOW}GNU 版本下载失败，尝试 MUSL...${RESET}"
            DOWNLOAD_URL="https://github.com/cfal/shoes/releases/download/v${LATEST_VER}/${MUSL_FILE}"
            wget -O shoes.tar.gz "$DOWNLOAD_URL" || exit 1
        else
            exit 1
        fi
    }

    tar -xzf shoes.tar.gz
    mv shoes "${SHOES_BIN}"
    chmod +x "${SHOES_BIN}"
}

# ================== 核心安装逻辑 ==================
install_shoes() {
    echo -e "${GREEN}=== 开始安装 Shoes (Config Fix) ===${RESET}"
    download_shoes
    mkdir -p "${SHOES_CONF_DIR}"

    # 1. 基础信息
    HOST_NAME=$(hostname)
    [[ -z "$HOST_NAME" ]] && HOST_NAME="ShoeServer"
    SNI="icloud.com"

    # 2. 生成端口
    VLESS_PORT=$(shuf -i 20000-60000 -n 1)
    ANYTLS_PORT=$(shuf -i 20000-60000 -n 1)
    SS_PORT=$(shuf -i 20000-60000 -n 1)
    while [[ "$ANYTLS_PORT" == "$VLESS_PORT" ]]; do ANYTLS_PORT=$(shuf -i 20000-60000 -n 1); done
    while [[ "$SS_PORT" == "$VLESS_PORT" || "$SS_PORT" == "$ANYTLS_PORT" ]]; do SS_PORT=$(shuf -i 20000-60000 -n 1); done

    # 3. 生成 Reality 密钥
    echo -e "${YELLOW}生成 Reality 密钥...${RESET}"
    UUID=$(cat /proc/sys/kernel/random/uuid)
    KEYPAIR=$(${SHOES_BIN} generate-reality-keypair 2>/dev/null)
    if [[ -z "$KEYPAIR" ]]; then
        echo -e "${RED}警告：二进制文件无法生成密钥，请检查兼容性！${RESET}"
        exit 1
    else
        PRIVATE_KEY=$(echo "$KEYPAIR" | grep "private key" | awk '{print $4}')
        PUBLIC_KEY=$(echo "$KEYPAIR" | grep "public key" | awk '{print $4}')
    fi
    SHID=$(openssl rand -hex 8)

    # 4. 生成 SS-2022 密钥
    echo -e "${YELLOW}生成 SS-2022 (AES-256-GCM) 密钥...${RESET}"
    SS_METHOD="2022-blake3-aes-256-gcm"
    # AES-256 需要 32 字节密钥 (Base64)
    SS_PASSWORD=$(openssl rand -base64 32)

    # 5. 生成自签名证书 (AnyTLS)
    echo -e "${YELLOW}生成 AnyTLS 证书...${RESET}"
    openssl ecparam -genkey -name prime256v1 -out "${SHOES_CONF_DIR}/key.pem"
    openssl req -new -x509 -days 3650 -key "${SHOES_CONF_DIR}/key.pem" -out "${SHOES_CONF_DIR}/cert.pem" -subj "/CN=${SNI}" >/dev/null 2>&1

    # 6. 写入配置文件
    # 关键修复：SS 协议中使用 'cipher' 而不是 'method'
    cat > "${SHOES_CONF_FILE}" <<EOF
- address: "0.0.0.0:${VLESS_PORT}"
  protocol:
    type: tls
    reality_targets:
      "${SNI}":
        private_key: "${PRIVATE_KEY}"
        short_ids: ["${SHID}"]
        dest: "${SNI}:443"
        vision: true
        protocol:
          type: vless
          user_id: "${UUID}"
          udp_enabled: true
- address: "0.0.0.0:${ANYTLS_PORT}"
  protocol:
    type: tls
    tls_targets:
      "${SNI}":
        cert: "${SHOES_CONF_DIR}/cert.pem"
        key: "${SHOES_CONF_DIR}/key.pem"
        protocol:
          type: anytls
          users:
            - name: anylts
              password: "${PUBLIC_KEY}"
          udp_enabled: true
- address: "0.0.0.0:${SS_PORT}"
  protocol:
    type: shadowsocks
    cipher: "${SS_METHOD}"
    password: "${SS_PASSWORD}"
    udp_enabled: true
EOF

    # 7. 配置 Systemd
    cat > "${SYSTEMD_FILE}" <<EOF
[Unit]
Description=Shoes Proxy Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=${SHOES_CONF_DIR}
ExecStart=${SHOES_BIN} ${SHOES_CONF_FILE}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

    # 8. 启动服务
    systemctl daemon-reload
    systemctl enable shoes
    echo -e "${YELLOW}正在启动服务...${RESET}"
    systemctl restart shoes
    
    sleep 3

    # 9. 状态检查与链接生成
    check_running() { systemctl is-active --quiet shoes; }
    
    if check_running; then
        HOST_IP=$(curl -s -4 http://www.cloudflare.com/cdn-cgi/trace | grep ip | awk -F= '{print $2}')
        # 构建 SS 链接 (通常客户端链接仍称之为 method，但服务端配置用 cipher)
        SS_BASE=$(echo -n "${SS_METHOD}:${SS_PASSWORD}" | base64 -w 0)

        cat > "${SHOES_LINK_FILE}" <<EOF
# Reality
vless://${UUID}@${HOST_IP}:${VLESS_PORT}?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${SNI}&fp=random&pbk=${PUBLIC_KEY}&sid=${SHID}&type=tcp#${HOST_NAME}

# AnyTLS
anytls://${PUBLIC_KEY}@${HOST_IP}:${ANYTLS_PORT}?security=tls&sni=${SNI}&allowInsecure=1&type=tcp#${HOST_NAME}_Anytls

# Shadowsocks-2022 (AES-256)
ss://${SS_BASE}@${HOST_IP}:${SS_PORT}#${HOST_NAME}_SS
EOF
        echo -e "${GREEN}安装成功！服务运行正常。${RESET}"
        echo -e "${GREEN}------------------------------------------------${RESET}"
        cat "${SHOES_LINK_FILE}"
        echo -e "${GREEN}------------------------------------------------${RESET}"
    else
        echo -e "${RED}服务启动失败！${RESET}"
        echo -e "${YELLOW}尝试前台调试信息:${RESET}"
        ${SHOES_BIN} ${SHOES_CONF_FILE}
    fi
}

# ================== 卸载 ==================
uninstall_shoes() {
    systemctl stop shoes
    systemctl disable shoes
    rm -f "${SYSTEMD_FILE}"
    rm -rf "${SHOES_CONF_DIR}"
    rm -f "${SHOES_BIN}"
    systemctl daemon-reload
    echo -e "${GREEN}Shoes 已完全卸载${RESET}"
}

# ================== 菜单 ==================
show_menu() {
    clear
    echo -e "${GREEN}=== Shoes 管理脚本 (Fix: cipher field) ===${RESET}"
    echo "1. 安装/重置服务 (VLESS + AnyTLS + SS-2022)"
    echo "2. 卸载服务"
    echo "3. 启动服务"
    echo "4. 停止服务"
    echo "5. 重启服务"
    echo "6. 查看节点链接"
    echo "7. 查看日志"
    echo "0. 退出"
    echo -e "${GREEN}==========================================${RESET}"
    read -p "请输入选项: " choice
}

require_root
while true; do
    show_menu
    case "$choice" in
        1) install_shoes ;;
        2) uninstall_shoes ;;
        3) systemctl start shoes; echo "已发送启动命令" ;;
        4) systemctl stop shoes; echo "已停止" ;;
        5) systemctl restart shoes; echo "已重启" ;;
        6) [[ -f "${SHOES_LINK_FILE}" ]] && cat "${SHOES_LINK_FILE}" || echo "文件不存在" ;;
        7) journalctl -u shoes -f ;;
        0) exit 0 ;;
        *) echo "无效选项" ;;
    esac
    read -p "按 Enter 继续..."
done
