#!/bin/bash

# ================== 变量定义 ==================
SHOES_BIN="/usr/local/bin/shoes"
SHOES_CONF_DIR="/etc/shoes"
SHOES_CONF_FILE="${SHOES_CONF_DIR}/config.yaml"
SYSTEMD_FILE="/etc/systemd/system/shoes.service"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RESET='\033[0m'

# ================== 自动侦测逻辑 ==================
detect_and_fix() {
    echo -e "${YELLOW}正在停止服务以进行启动项侦测...${RESET}"
    systemctl stop shoes

    # 确保配置文件存在
    if [[ ! -f "$SHOES_CONF_FILE" ]]; then
        echo -e "${RED}错误：配置文件不存在！请先运行安装选项。${RESET}"
        return
    fi

    # 定义 4 种可能的启动命令模式
    # 模式1: 标准 run -c (当前失败的)
    CMD_1="${SHOES_BIN} run -c ${SHOES_CONF_FILE}"
    # 模式2: 先指定 -c 再 run
    CMD_2="${SHOES_BIN} -c ${SHOES_CONF_FILE} run"
    # 模式3: 指定工作目录 run (不带 -c)
    CMD_3="${SHOES_BIN} -D ${SHOES_CONF_DIR} run"
    # 模式4: run --config (全称)
    CMD_4="${SHOES_BIN} run --config ${SHOES_CONF_FILE}"

    SUCCESS_CMD=""

    # 循环测试
    for i in 1 2 3 4; do
        current_cmd_var="CMD_$i"
        current_cmd="${!current_cmd_var}"
        
        echo -e "正在测试启动模式 [$i]: ${YELLOW}${current_cmd}${RESET}"
        
        # 运行命令，超时 3 秒。
        # 如果 3 秒后是被 timeout 杀掉的 (124)，说明程序成功跑起来了没崩溃。
        # 如果是立即退出 (101 或 1)，说明崩溃了。
        timeout 3s $current_cmd >/dev/null 2>&1
        EXIT_CODE=$?

        if [[ $EXIT_CODE -eq 124 ]]; then
            echo -e "${GREEN}>>> 模式 [$i] 测试成功！程序可以稳定运行。${RESET}"
            SUCCESS_CMD="$current_cmd"
            break
        elif [[ $EXIT_CODE -eq 101 ]]; then
             echo -e "${RED}>>> 模式 [$i] 失败 (Panic/崩溃)${RESET}"
        else
             echo -e "${RED}>>> 模式 [$i] 失败 (退出码: $EXIT_CODE)${RESET}"
        fi
    done

    # 应用修复
    if [[ -n "$SUCCESS_CMD" ]]; then
        echo -e "${YELLOW}正在将成功命令应用到系统服务...${RESET}"
        
        cat > "${SYSTEMD_FILE}" <<EOF
[Unit]
Description=Shoes Proxy Server
After=network.target

[Service]
Type=simple
User=root
ExecStart=${SUCCESS_CMD}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
        systemctl daemon-reload
        systemctl enable shoes
        systemctl restart shoes
        sleep 2
        
        if systemctl is-active --quiet shoes; then
            echo -e "${GREEN}修复完成！Shoes 服务已成功启动。${RESET}"
            echo -e "最终使用的启动命令: ${YELLOW}${SUCCESS_CMD}${RESET}"
            
            # 显示 SS 端口提醒
            SS_PORT=$(grep "address: \"0.0.0.0:" "${SHOES_CONF_FILE}" | tail -n 1 | awk -F: '{print $3}' | tr -d '"')
            echo -e "${GREEN}SS-2022 端口 (参考): ${SS_PORT}${RESET}"
        else
            echo -e "${RED}虽然测试通过，但 Systemd 启动仍失败。请查看日志。${RESET}"
        fi
    else
        echo -e "${RED}所有启动模式均失败！可能是二进制文件版本不兼容或配置文件有语法错误。${RESET}"
        echo -e "建议：尝试手动修改配置文件，将 encryption 改为 none，或者检查 config.yaml 内容。"
    fi
}

# ================== 菜单 ==================
show_menu() {
    clear
    echo -e "${GREEN}=== Shoes 自动修复工具 (v5 Auto-Fix) ===${RESET}"
    echo "1. 开始自动侦测并修复启动项 (推荐)"
    echo "2. 查看当前配置文件"
    echo "3. 查看当前服务日志"
    echo "0. 退出"
    echo -e "${GREEN}=========================================${RESET}"
    read -p "请输入选项: " choice
}

# 主逻辑
if [[ $EUID -ne 0 ]]; then
    echo -e "${RED}必须使用 root 权限！${RESET}"
    exit 1
fi

while true; do
    show_menu
    case "$choice" in
        1) detect_and_fix; read -p "按回车继续..." ;;
        2) cat "${SHOES_CONF_FILE}"; read -p "按回车继续..." ;;
        3) journalctl -u shoes -n 20 --no-pager; read -p "按回车继续..." ;;
        0) exit 0 ;;
        *) echo "无效选项" ;;
    esac
done
